SELECT livros.titulo_livro, alunos.nome_aluno, funcionarios.nome_funcionario 
FROM emprestimos inner join livros ON 
	emprestimos.livros_id_livro = livros.id_livro JOIN alunos ON 
    emprestimos.alunos_id_aluno = alunos.id_aluno JOIN funcionarios ON
    emprestimos.funcionarios_id_funcionario = funcionarios.id_funcionario;
